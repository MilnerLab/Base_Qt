/* ui/theme/base.qss */

/* typography baseline */
QWidget {
  font-size: 13px;
}

/* Section headers / helper labels */
QLabel[role="section_title"] {
  font-size: 16px;
  font-weight: 600;
}
QLabel[role="muted"] { }
QLabel[role="error"] {
  font-size: 12px;
}
QLabel[role="readout"] {
  min-height: @control_h@px;
  padding-left: @s@px;
  padding-right: @s@px;
  border-width: @border_w@px;
  border-style: solid;
  border-radius: @r_m@px;
}

/* Card container */
QFrame#Card {
  border-width: @border_w@px;
  border-style: solid;
  border-radius: @r_l@px;
}

/* Scroll areas paint an opaque QPalette::Base background by default; make
   the area and its auto-created viewport transparent so ancestors (e.g.
   QFrame#Card) show through instead of a stray light patch. */
QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget {
  background: transparent;
}

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
  min-height: @control_h@px;
  padding-left: @s@px;
  padding-right: @s@px;
  border-width: @border_w@px;
  border-style: solid;
  border-radius: @r_m@px;
}

/* Spin box up/down buttons + arrows — needed once QAbstractSpinBox gets a
   custom border above: Qt then renders these sub-controls itself, and any
   sub-control left unstyled falls back to native (light) rendering instead
   of following the stylesheet. */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
  subcontrol-origin: border;
  width: 16px;
  border-style: solid;
  border-width: 0px 0px 0px @border_w@px;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
  subcontrol-position: top right;
  border-top-right-radius: @r_m@px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
  subcontrol-position: bottom right;
  border-bottom-right-radius: @r_m@px;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
  width: 0px;
  height: 0px;
  border-left: 3px solid transparent;
  border-right: 3px solid transparent;
  border-bottom-width: 5px;
  border-bottom-style: solid;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
  width: 0px;
  height: 0px;
  border-left: 3px solid transparent;
  border-right: 3px solid transparent;
  border-top-width: 5px;
  border-top-style: solid;
}

/* Combo box dropdown popup — QComboBox's own rules above don't reach the
   popup's QAbstractItemView, which otherwise falls back to Qt's default
   (unstyled) item palette. */
QComboBox QAbstractItemView {
  border-width: @border_w@px;
  border-style: solid;
  border-radius: @r_m@px;
  outline: 0;
}
QComboBox QAbstractItemView::item {
  min-height: @control_h@px;
  padding-left: @s@px;
  padding-right: @s@px;
}

/* Buttons */
QPushButton, QToolButton {
  min-height: @control_h@px;
  padding-left: @m@px;
  padding-right: @m@px;
  border-width: @border_w@px;
  border-style: solid;
  border-radius: @r_m@px;
}

/* Role variants: only structural changes here */
QPushButton[role="primary"], QToolButton[role="primary"] {
  font-weight: 600;
  border-width: 0px;
}
QPushButton[role="danger"], QToolButton[role="danger"] {
  font-weight: 600;
  border-width: 0px;
}

QAbstractButton#ToggleSwitch {
  min-width: 56px;
  min-height: 28px;
}

/* Panel header strip */
QLabel#panel_header {
  font-weight: 600;
  font-size: 12px;
  padding: @s@px @m@px;
  border-bottom-width: @border_w@px;
  border-bottom-style: solid;
}

/* PanelView title bar */
QWidget#popout_header {
  font-weight: 600;
  font-size: 12px;
  min-height: @xl@px;
  border-bottom-width: @border_w@px;
  border-bottom-style: solid;
}

/* Menubar status area */
QLabel#status_dot {
  border-radius: 4px;
}

QLabel#status_text {
  font-size: 12px;
}

QLabel#status_counter {
  font-size: 11px;
  min-width: 28px;
}

QToolButton#status_nav_btn {
  font-size: 11px;
  min-width: 18px;
  min-height: 18px;
  padding: 0px 2px;
  border-radius: @r_s@px;
  border: none;
}