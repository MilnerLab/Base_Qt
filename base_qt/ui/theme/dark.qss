/* ui/theme/dark.qss */

QWidget {
  color: rgba(255,255,255,230);
}

QMainWindow, QDialog {
  background-color: #1E1F22;
}

QFrame#Card {
  background-color: #2B2D31;
  border-color: rgba(255,255,255,35);
}

QLabel[role="muted"] {
  color: rgba(255,255,255,150);
}

QLabel[role="error"] {
  color: rgba(255,120,120,230);
}

QLabel[role="readout"] {
  background-color: rgba(255,255,255,10);
  border-color: rgba(255,255,255,25);
  color: rgba(255,255,255,190);
}

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
  background-color: #2B2D31;
  border-color: rgba(255,255,255,40);
  color: rgba(255,255,255,230);
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
  border-color: rgba(30, 120, 255, 200);
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
  color: rgba(255,255,255,120);
  background-color: rgba(255,255,255,10);
  border-color: rgba(255,255,255,25);
}

/* Spin box up/down buttons & arrows */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
  background-color: #2B2D31;
  border-left-color: rgba(255,255,255,40);
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
  background-color: rgba(255,255,255,8);
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
  background-color: rgba(255,255,255,12);
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
  border-bottom-color: rgba(255,255,255,180);
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
  border-top-color: rgba(255,255,255,180);
}
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
  border-bottom-color: rgba(255,255,255,60);
}
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
  border-top-color: rgba(255,255,255,60);
}

/* Combo box dropdown popup */
QComboBox QAbstractItemView {
  background-color: #2B2D31;
  border-color: rgba(255,255,255,40);
  color: rgba(255,255,255,230);
  selection-background-color: rgba(30,120,255,220);
  selection-color: #FFFFFF;
}
QComboBox QAbstractItemView::item:hover {
  background-color: rgba(30,120,255,220);
  color: #FFFFFF;
}
QComboBox QAbstractItemView::item:selected {
  background-color: rgba(30,120,255,160);
  color: #FFFFFF;
}

/* Buttons */
QPushButton, QToolButton {
  background-color: #2B2D31;
  border-color: rgba(255,255,255,40);
  color: rgba(255,255,255,230);
}

QPushButton:hover, QToolButton:hover { background-color: rgba(255,255,255,8); }
QPushButton:pressed, QToolButton:pressed { background-color: rgba(255,255,255,12); }

QPushButton:disabled, QToolButton:disabled {
  color: rgba(255,255,255,120);
  background-color: rgba(255,255,255,10);
  border-color: rgba(255,255,255,25);
}

QPushButton[role="primary"], QToolButton[role="primary"] {
  color: #FFFFFF;
  background-color: rgba(30,120,255,220);
}

QPushButton[role="danger"], QToolButton[role="danger"] {
  color: #FFFFFF;
  background-color: rgba(220,60,60,220);
}

QAbstractButton#ToggleSwitch {
  qproperty-trackOff: rgba(255,255,255,20);
  qproperty-trackBorder: rgba(255,255,255,40);
  qproperty-thumbFill: rgba(255,255,255,230);
  qproperty-thumbBorder: rgba(255,255,255,40);
  qproperty-textOn: rgba(255,255,255,255);
  qproperty-textOff: rgba(255,255,255,160);
  qproperty-trackDisabled: rgba(255,255,255,10);
  qproperty-textDisabled: rgba(255,255,255,120);
  qproperty-thumbDisabled: rgba(255,255,255,180);
}

QAbstractButton#ToggleSwitch[role="primary"] { qproperty-trackOn: rgba(30,120,255,220); }
QAbstractButton#ToggleSwitch[role="danger"]  { qproperty-trackOn: rgba(220,60,60,220); }

/* Panel header */
QLabel#panel_header {
  color: rgba(255,255,255,180);
  background-color: rgba(255,255,255,5);
  border-bottom-color: rgba(255,255,255,15);
}

/* Menu bar & menus (pinned dark so they stay visible regardless of the OS palette) */
QMenuBar {
  background-color: #1E1F22;
  color: rgba(255,255,255,230);
}
QMenuBar::item {
  background: transparent;
  padding: 4px 10px;
}
QMenuBar::item:selected { background-color: rgba(255,255,255,20); }
QMenuBar::item:pressed  { background-color: rgba(255,255,255,30); }

QMenu {
  background-color: #2B2D31;
  color: rgba(255,255,255,230);
  border: 1px solid rgba(255,255,255,40);
}
QMenu::item { padding: 6px 24px; }
QMenu::item:selected { background-color: rgba(30,120,255,220); color: #FFFFFF; }
QMenu::item:disabled { color: rgba(255,255,255,120); }
QMenu::separator { height: 1px; background: rgba(255,255,255,25); margin: 4px 8px; }

/* Menubar status */
QLabel#status_dot { background: transparent; }
QLabel#status_dot[level="info"]    { background: rgba(80,200,120,220); }
QLabel#status_dot[level="warning"] { background: rgba(255,180,0,220); }
QLabel#status_dot[level="error"]   { background: rgba(255,80,80,220); }

QLabel#status_text { color: rgba(255,255,255,120); }
QLabel#status_text[level="warning"] { color: rgba(255,180,0,220); }
QLabel#status_text[level="error"]   { color: rgba(255,80,80,220); font-weight: 600; }

QLabel#status_counter { color: rgba(255,255,255,100); }

QToolButton#status_nav_btn { color: rgba(255,255,255,160); background: transparent; }
QToolButton#status_nav_btn:hover   { background: rgba(255,255,255,10); }
QToolButton#status_nav_btn:pressed { background: rgba(255,255,255,15); }
QToolButton#status_nav_btn:disabled { color: rgba(255,255,255,40); }